# ---- General ----
# Which data source to use: mock | serpapi | duffel | travelpayouts
FLIGHT_PROVIDER=mock
ORIGIN_AIRPORT=TLV
CURRENCY=USD
APP_HOST=127.0.0.1
APP_PORT=8000
HTTP_TIMEOUT_SECONDS=40

# ---- Data providers (fill only the one you use) ----
# https://serpapi.com  (Google Flights engine)
SERPAPI_API_KEY=
# https://duffel.com  (live airline offers; test tokens start with duffel_test_)
DUFFEL_ACCESS_TOKEN=
# https://www.travelpayouts.com  (Aviasales Data API - free, cached prices)
TRAVELPAYOUTS_TOKEN=

# ---- Telegram notifications ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Email notifications (e.g. Gmail with an App Password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
